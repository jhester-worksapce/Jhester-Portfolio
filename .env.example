# Set actual secrets only in .env.local or Vercel Environment Variables.
GEMINI_API_KEY=
# GOOGLE_API_KEY is also supported if GEMINI_API_KEY is empty.
GEMINI_MODEL=gemini-3.5-flash
# Optional on Vercel: production URL is detected automatically.
SITE_URL=
# Optional: verification token from Google Search Console.
GOOGLE_SITE_VERIFICATION=
